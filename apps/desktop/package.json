{
  "name": "@deva/desktop",
  "version": "0.1.10",
  "description": "Deva 桌面应用",
  "main": "./out/main/index.js",
  "author": "kyaring",
  "homepage": "https://github.com/kyaring/deva",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:headless": "node scripts/build-headless.mjs",
    "headless": "node out/headless/deva-headless.cjs",
    "build:headless:bun": "sh scripts/build-headless-bun.sh"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@humation/assets-humation-1": "^1.0.3",
    "@humation/core": "^1.0.3",
    "@humation/react": "^1.0.3",
    "@larksuiteoapi/node-sdk": "^1.74.0",
    "@lexical/history": "0.52.0",
    "@lexical/plain-text": "0.52.0",
    "@lexical/text": "0.52.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron-updater": "6.3.9",
    "fflate": "^0.8.3",
    "lexical": "0.52.0",
    "lucide-react": "^0.454.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "socks": "^2",
    "undici": "^6"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "bun": "1.4.4",
    "electron": "33.4.11",
    "electron-builder": "^26.17.0",
    "electron-vite": "^2.3.0",
    "esbuild": "0.21.5",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
