# 复制为 /etc/deva/deva.env（root:root，权限 0600）后填写。
# 主密钥：32 字节随机数的 base64。生成：openssl rand -base64 32
# 丢失它将无法解密已保存的 API Key 与机器人 Token，请妥善备份。
DEVA_MASTER_KEY=

# 访问 Telegram / 模型服务需要代理时取消注释（NO_PROXY 中的主机直连）
# 支持 socks5:// 与 http://，例如：
# HTTPS_PROXY=socks5://192.168.20.189:1070
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,.internal.lan
